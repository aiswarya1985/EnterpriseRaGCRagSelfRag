{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PATH": "C:\\Program Files\\PostgreSQL\\18\\bin;${env:PATH}",
        "PSYCOPG_IMPL": "python"
      },
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Streamlit",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "scripts/streamlit_app.py", "--server.port", "8501"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Seed DB + Ingest docs",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.seed_db",
      "args": ["--noise-sample", "0"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug run_ragas.py",
      "type": "debugpy",
      "request": "launch",
      "module": "eval.run_ragas",
      "args": ["--profile", "all"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Attach to run_ragas.py",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "Full Stack Debug (Streamlit + FastAPI)",
      "configurations": ["FastAPI (uvicorn)", "Streamlit"],
      "stopAll": true
    }
  ]
}
